# Supabase > Connect > Session pooler (porta 5432; IPv4). Nunca colocar esta URL no app.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:SENHA_URL_ENCODED@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=CHAVE_PUBLICAVEL_OU_ANON
# Usuários previamente criados e com e-mail confirmado no Supabase Auth.
UPLOADER_EMAILS=seuemail@exemplo.com
ALLOWED_ORIGINS=
MARKET_CACHE_SECONDS=900
DEMO_MODE=false
